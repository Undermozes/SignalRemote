@page "/assistant/{deviceId}"
@attribute [Authorize]
@inherits AuthComponentBase
@implements IDisposable
@using Remotely.Server.Services.ClaudeAssistant

@* Chat layout: the log scrolls, the composer stays at the bottom.  Embedded = panel in the viewer. *@
<div class="flex flex-col text-fg @(Embedded ? "h-dvh bg-surface p-2" : "h-[calc(100dvh-6.5rem)] md:h-[calc(100dvh-2rem)]")">
    <div class="mb-2 flex min-w-0 items-baseline gap-2">
        <h3 class="m-0 shrink-0 font-semibold @(Embedded ? "text-base" : "text-2xl")">Claude Assistant</h3>
        @if (_session is not null)
        {
            <button type="button" class="sr-btn sr-btn-sm sr-btn-ghost order-last ml-auto shrink-0" title="Start a new conversation"
                    @onclick="() => { if (_session.SnapshotEntries().Any(x => x.Kind == AssistantEntryKind.User)) _confirmNew = true; else _ = NewConversation(); }">
                <Icon Name="sparkles" Class="size-3.5" /> New
            </button>
        }
        @if (_session is not null)
        {
            <span class="truncate text-sm text-muted">
                @_session.Device.DeviceName
                @if (!string.IsNullOrWhiteSpace(_session.Device.Alias))
                {
                    <span>(@_session.Device.Alias)</span>
                }
            </span>
        }
    </div>

    @if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <div class="sr-alert sr-alert-warning">@_errorMessage</div>
    }
    else if (_session is null)
    {
        <div class="text-muted">Loading...</div>
    }
    else
    {
        <details class="mb-2 text-xs text-muted">
            <summary class="cursor-pointer select-none">
                How Claude works on this device ·
                <a href="assistant-history/@_session.SessionId" target="_blank" rel="noopener">History of this session</a>
            </summary>
            <p class="mt-1 mb-0">
                Claude runs commands on this device through the agent.  The approval mode decides
                which commands wait for you.  The conversation keeps running on the server when you
                close or refresh this page, and continues when you come back.
                Every command is logged and appears in the device's script history.
                @if (_session.ScreenshotsEnabled)
                {
                    <span>Claude can see the remote screen.</span>
                }
            </p>
        </details>

        @if (_confirmNew)
        {
            <div class="sr-alert sr-alert-warning mb-2 flex-col text-xs sm:flex-row sm:items-center" role="alertdialog" aria-label="Confirm new conversation">
                <div class="flex-1">
                    <strong>Start a new conversation?</strong>
                    @(_session.IsBusy ? "Claude stops what it is doing. " : "")This one stays in Claude History, where you can continue it later.
                </div>
                <div class="flex w-full gap-2 sm:w-auto">
                    <button class="sr-btn sr-btn-sm sr-btn-secondary flex-1 sm:flex-none" @onclick="() => _confirmNew = false">Cancel</button>
                    <button class="sr-btn sr-btn-sm sr-btn-primary flex-1 sm:flex-none" @onclick="NewConversation">New conversation</button>
                </div>
            </div>
        }

        @* Approval mode for this session. *@
        <div class="mb-2 flex flex-wrap items-center gap-2 text-xs">
            <span class="text-muted">Approval:</span>
            <div class="inline-flex rounded-lg border border-border bg-surface-sunken p-0.5" role="radiogroup" aria-label="Approval mode">
                @foreach (var mode in Enum.GetValues<ApprovalMode>().Where(x => x.IsAllowedFor(User!)))
                {
                    var active = _session.Mode == mode;
                    <button type="button" role="radio" aria-checked="@(active ? "true" : "false")"
                            title="@mode.Description()"
                            class="min-h-8 rounded-md px-2.5 font-medium transition-colors @(active ? (mode == ApprovalMode.AllowAll ? "bg-danger text-white shadow-sm" : "bg-surface-raised text-fg shadow-sm") : "text-muted hover:text-fg")"
                            @onclick="() => ChooseMode(mode)">
                        @mode.ShortName()
                    </button>
                }
            </div>
            <span class="w-full text-muted sm:w-auto sm:min-w-0 sm:flex-1 sm:truncate">@_session.Mode.Description()</span>
        </div>

        @if (_confirmAllowAll)
        {
            <div class="sr-alert sr-alert-danger mb-2 flex-col text-xs sm:flex-row sm:items-center" role="alertdialog" aria-label="Confirm allow all">
                <div class="flex-1">
                    <strong>Run every command without asking?</strong>
                    Claude can then change this device as SYSTEM/root without your approval, including
                    commands waiting now.  It stays on until you switch back or close this session.
                </div>
                <div class="flex w-full gap-2 sm:w-auto">
                    <button class="sr-btn sr-btn-sm sr-btn-secondary flex-1 sm:flex-none" @onclick="() => _confirmAllowAll = false">Cancel</button>
                    <button class="sr-btn sr-btn-sm sr-btn-danger flex-1 sm:flex-none" @onclick="ConfirmAllowAll">Allow all</button>
                </div>
            </div>
        }
        else if (_session.Mode == ApprovalMode.AllowAll)
        {
            <div class="sr-alert sr-alert-danger mb-2 items-center text-xs" role="status">
                <span class="flex-1"><strong>Allow all is on.</strong> Claude runs every command without asking.</span>
                <button class="sr-btn sr-btn-sm sr-btn-secondary" @onclick="() => ChooseMode(ApprovalMode.AllowReadOnly)">Back to @ApprovalMode.AllowReadOnly.ShortName()</button>
            </div>
        }

        <div @ref="_logElement"
             class="min-h-0 flex-1 space-y-3 overflow-y-auto rounded-xl border border-border bg-surface-sunken p-3">
            @if (_session.SnapshotEntries().Length == 0)
            {
                <div class="py-8 text-center text-sm text-muted">
                    Describe the problem and Claude will investigate this device.
                </div>
            }

            @foreach (var entry in _session.SnapshotEntries())
            {
                switch (entry.Kind)
                {
                    case AssistantEntryKind.User:
                        <div class="flex justify-end">
                            <div class="max-w-[85%] rounded-2xl rounded-br-sm bg-brand px-3 py-2 text-brand-contrast">
                                <div class="text-[0.7rem] font-semibold opacity-80">@UserName</div>
                                <div class="whitespace-pre-wrap break-words">@entry.Text</div>
                            </div>
                        </div>
                        break;

                    case AssistantEntryKind.Assistant:
                        <div class="flex justify-start">
                            <div class="max-w-[92%] rounded-2xl rounded-bl-sm border border-border bg-surface-raised px-3 py-2">
                                <div class="text-[0.7rem] font-semibold text-muted">Claude</div>
                                <div class="whitespace-pre-wrap break-words">@entry.Text</div>
                            </div>
                        </div>
                        break;

                    case AssistantEntryKind.Command:
                        <div class="sr-card overflow-hidden">
                            <div class="flex flex-wrap items-center gap-2 border-b border-border px-3 py-2 text-xs">
                                <span class="sr-badge @(entry.IsReadOnly ? "sr-badge-neutral" : "sr-badge-warning")">
                                    @(entry.IsReadOnly ? "Read-only" : "Changes system")
                                </span>
                                <span class="font-mono">@entry.Shell</span>
                                <span class="ml-auto text-muted">@GetStateLabel(entry)</span>
                            </div>
                            <div class="space-y-2 p-3">
                                @if (!string.IsNullOrWhiteSpace(entry.Purpose))
                                {
                                    <div class="text-sm">@entry.Purpose</div>
                                }
                                <pre class="m-0 max-h-48 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-surface-sunken p-2 font-mono text-xs">@entry.Command</pre>
                                @if (!entry.IsReadOnly)
                                {
                                    <div class="text-xs text-muted">Why approval is needed: @entry.ClassificationReason</div>
                                }

                                @if (entry.State == CommandState.AwaitingApproval)
                                {
                                    <div class="flex flex-col gap-2 sm:flex-row sm:items-center">
                                        <button class="sr-btn sr-btn-success w-full sm:w-auto" @onclick="() => Approve(entry)">Approve and run</button>
                                        <input class="sr-input sm:flex-1"
                                               placeholder="Optional note for Claude"
                                               @bind="_rejectNote" />
                                        <button class="sr-btn sr-btn-danger w-full sm:w-auto" @onclick="() => Reject(entry)">Reject</button>
                                    </div>
                                }
                                else if (!string.IsNullOrWhiteSpace(entry.Output))
                                {
                                    <details>
                                        <summary class="cursor-pointer text-xs text-muted">Output</summary>
                                        <pre class="mt-1 mb-0 max-h-72 overflow-auto whitespace-pre-wrap break-words rounded-lg bg-surface-sunken p-2 font-mono text-xs">@entry.Output</pre>
                                    </details>
                                }
                            </div>
                        </div>
                        break;

                    case AssistantEntryKind.Info:
                        <div class="text-center text-xs italic text-muted">@entry.Text</div>
                        break;

                    case AssistantEntryKind.Error:
                        <div class="sr-alert sr-alert-danger mb-0">@entry.Text</div>
                        break;
                }
            }

            @if (_session.IsBusy)
            {
                <div class="flex items-center gap-2 text-sm text-muted" role="status">
                    <span class="size-4 animate-spin rounded-full border-2 border-muted border-t-transparent"></span>
                    <span>@(string.IsNullOrWhiteSpace(_session.Status) ? "Claude is working..." : _session.Status)</span>
                    @if (_session.BusySince is DateTimeOffset since)
                    {
                        <span class="tabular-nums">@FormatElapsed(DateTimeOffset.Now - since)</span>
                    }
                </div>
            }
        </div>

        <div class="mt-2 flex items-end gap-2 pb-[env(safe-area-inset-bottom)]">
            <textarea class="sr-textarea min-h-11 flex-1 resize-none"
                      rows="2"
                      placeholder="@(Embedded ? "Describe the problem, e.g. \"Find out why this website is slow in Chrome.\"" : "Describe the problem, e.g. \"The user says Outlook is slow since this morning.\"")"
                      disabled="@_session.IsBusy"
                      @bind="_input"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"></textarea>
            @if (_session.IsBusy)
            {
                <button class="sr-btn sr-btn-secondary" @onclick="() => _session.CancelTurn()">Stop</button>
            }
            else
            {
                <button class="sr-btn sr-btn-primary" @onclick="Send">Send</button>
            }
        </div>
    }
</div>

@code {
    private ClaudeAssistantSession? _session;
    private string? _errorMessage;
    private string _input = string.Empty;
    private string _rejectNote = string.Empty;
    private bool _confirmAllowAll;
    private bool _confirmNew;
    private Func<CancellationToken, Task<ViewerScreenshot>>? _screenshotSource;

    private IJSObjectReference? _embedModule;
    private ElementReference _logElement;
    private int _renderedEntryCount;
    private System.Threading.Timer? _ticker;

    [Parameter]
    public string DeviceId { get; set; } = string.Empty;

    /// <summary>
    /// True when shown as a panel inside the remote control viewer.  Claude can then
    /// take screenshots of the remote screen through the viewer.
    /// </summary>
    [Parameter]
    public bool Embedded { get; set; }

    /// <summary>An earlier session from the history to continue (?continue=&lt;session id&gt;).</summary>
    [SupplyParameterFromQuery(Name = "continue")]
    public Guid? ContinueSessionId { get; set; }

    [Inject]
    private IJSRuntime JS { get; set; } = null!;

    [Inject]
    private Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersion { get; set; } = null!;

    [Inject]
    private IClaudeAssistantService AssistantService { get; set; } = null!;

    [Inject]
    private IDataService DataService { get; set; } = null!;

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        if (User is null)
        {
            _errorMessage = "You must be signed in.";
            return;
        }

        // The page is prerendered first, then rendered again interactively.  Start the
        // session only in the interactive render, or every visit logs an empty extra session.
        if (!RendererInfo.IsInteractive)
        {
            return;
        }

        await AttachSession(startNew: false);

        // Keep the elapsed time ticking while Claude works.
        _ticker = new System.Threading.Timer(_ =>
        {
            if (_session?.IsBusy == true)
            {
                _ = InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    private static string FormatElapsed(TimeSpan elapsed) =>
        elapsed.TotalHours >= 1 ? elapsed.ToString(@"h\:mm\:ss") : elapsed.ToString(@"m\:ss");

    // The session keeps running on the server when this page goes away (refresh, phone
    // screen off, lost connection); the next page for this device picks it up again.
    private async Task AttachSession(bool startNew)
    {
        DetachSession();
        _renderedEntryCount = 0;

        var result = await AssistantService.StartSession(User!, DeviceId, startNew ? null : ContinueSessionId, startNew);
        if (!result.IsSuccess)
        {
            _errorMessage = result.Reason;
            return;
        }

        _session = result.Value;
        _session.Attach();
        if (Embedded)
        {
            _screenshotSource ??= CaptureViewerScreenshot;
            _session.ScreenshotProvider = _screenshotSource;
        }
        _session.Changed += HandleSessionChanged;
    }

    private void DetachSession()
    {
        if (_session is null)
        {
            return;
        }

        _session.Changed -= HandleSessionChanged;
        _session.Detach();
        if (_screenshotSource is not null && _session.ScreenshotProvider == _screenshotSource)
        {
            _session.ScreenshotProvider = null;
        }
        _session = null;
    }

    private async Task NewConversation()
    {
        _confirmNew = false;
        _confirmAllowAll = false;
        await AttachSession(startNew: true);
    }

    public void Dispose()
    {
        _ticker?.Dispose();
        DetachSession();

        if (_embedModule is not null)
        {
            _ = DisposeModule(_embedModule);
        }
    }

    private static async Task DisposeModule(IJSObjectReference module)
    {
        try
        {
            await module.DisposeAsync();
        }
        catch (JSDisconnectedException)
        {
            // The circuit is gone, so is the module.
        }
    }

    private async Task<ViewerScreenshot> CaptureViewerScreenshot(CancellationToken cancellationToken)
    {
        ViewerScreenshot? screenshot = null;

        // JS interop runs on the circuit's dispatcher.
        await InvokeAsync(async () =>
        {
            try
            {
                _embedModule ??= await JS.InvokeAsync<IJSObjectReference>("import", cancellationToken, FileVersion.AddFileVersionToPath(Microsoft.AspNetCore.Http.PathString.Empty, "/assistant-embed.js"));

                var info = await _embedModule.InvokeAsync<CaptureInfo>("captureViewerScreen", cancellationToken, 10_000);
                if (!info.Ok)
                {
                    screenshot = new(null, 0, 0, info.Error);
                    return;
                }

                // Streamed, because a capture is larger than the SignalR message size limit.
                var streamRef = await _embedModule.InvokeAsync<IJSStreamReference>("takeCapturedScreen", cancellationToken);
                await using var stream = await streamRef.OpenReadStreamAsync(maxAllowedSize: 8_000_000, cancellationToken);
                using var reader = new StreamReader(stream);
                var jpegBase64 = await reader.ReadToEndAsync(cancellationToken);
                screenshot = new(jpegBase64, info.Width, info.Height, null);
            }
            catch (JSException ex)
            {
                screenshot = new(null, 0, 0, ex.Message);
            }
            catch (JSDisconnectedException)
            {
                screenshot = new(null, 0, 0, "The assistant panel was closed.");
            }
        });

        return screenshot ?? new(null, 0, 0, "No screenshot available.");
    }

    private sealed record CaptureInfo(bool Ok, int Width, int Height, string? Error);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Follow the conversation as entries are added.
        if (_session is not null && _session.SnapshotEntries().Length != _renderedEntryCount)
        {
            _renderedEntryCount = _session.SnapshotEntries().Length;
            try
            {
                _embedModule ??= await JS.InvokeAsync<IJSObjectReference>("import", FileVersion.AddFileVersionToPath(Microsoft.AspNetCore.Http.PathString.Empty, "/assistant-embed.js"));
                await _embedModule.InvokeVoidAsync("scrollToBottom", _logElement);
            }
            catch (JSDisconnectedException)
            {
            }
        }
        await base.OnAfterRenderAsync(firstRender);
    }

    private void HandleSessionChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private async Task Send()
    {
        if (_session is null || _session.IsBusy || string.IsNullOrWhiteSpace(_input))
        {
            return;
        }

        var text = _input;
        _input = string.Empty;
        await _session.SendMessage(text);
    }

    private async Task HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && !args.ShiftKey)
        {
            await Send();
        }
    }

    private void ChooseMode(ApprovalMode mode)
    {
        if (_session is null)
        {
            return;
        }
        if (mode == ApprovalMode.AllowAll && _session.Mode != ApprovalMode.AllowAll)
        {
            _confirmAllowAll = true;
            return;
        }
        _confirmAllowAll = false;
        _session.SetMode(mode);
    }

    private void ConfirmAllowAll()
    {
        _confirmAllowAll = false;
        _session?.SetMode(ApprovalMode.AllowAll);
    }

    private void Approve(AssistantEntry entry)
    {
        _session?.Approve(entry);
    }

    private void Reject(AssistantEntry entry)
    {
        _session?.Reject(entry, _rejectNote);
        _rejectNote = string.Empty;
    }

    private static string GetStateLabel(AssistantEntry entry)
    {
        var label = entry.State switch
        {
            CommandState.AwaitingApproval => "Waiting for your approval",
            CommandState.Running => "Running...",
            CommandState.Completed => "Done",
            CommandState.Rejected => "Rejected",
            CommandState.Failed => "Failed",
            _ => string.Empty,
        };

        return entry.DecidedBy is null ? label : $"{label} · {entry.DecidedBy}";
    }
}
