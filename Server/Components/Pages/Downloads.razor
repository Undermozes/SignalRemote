@page "/downloads"
@attribute [Authorize]
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Logging 

@inject IAuthService Auth
@inject IDataService DataService
@inject UserManager<RemotelyUser> UserManager
@inject IWebHostEnvironment HostEnv
@inject NavigationManager NavManager
@inject IDownloadLinkService DownloadLinks
@inject ILogger<Downloads> Logger 

@if (_isAuthenticated)
{
    <div class="sr-alert sr-alert-info">
        <i class="oi oi-info mt-0.5" aria-hidden="true"></i>
        <div>Check out the <a class="font-medium text-brand underline" href="/deploy">Deploy</a> page for a copy-and-paste deploy script!</div>
    </div>
}

<section class="mb-8">
    <h4 class="sr-section-title mt-2">Portable Instant Support Clients</h4>
    <p class="mb-4 text-sm text-muted">
        Instant desktop sharing.  No account required.
    </p>
    <div class="sr-alert sr-alert-info">
        <div>
            These links work until <strong>@_linksExpireAt.ToLocalTime().ToString("ddd d MMM HH:mm")</strong>.
            Copy a link to send it to a customer. For other durations, use <a href="deploy">Deploy</a>.
        </div>
    </div>
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
        <div class="sr-card flex flex-col">
            <div class="sr-card-header">Windows (64-Bit)</div>
            <div class="sr-card-body flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <a target="_blank" class="sr-btn sr-btn-primary w-full justify-start text-base" href="@($"/api/ClientDownloads/Desktop/WindowsDesktop-x64/{_organizationId}{_tokenQuery}")">
                        <i class="oi oi-data-transfer-download" aria-hidden="true"></i>
                        <span>Windows EXE</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="sr-card flex flex-col">
            <div class="sr-card-header">Windows (32-Bit)</div>
            <div class="sr-card-body flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <a target="_blank" class="sr-btn sr-btn-primary w-full justify-start text-base" href="@($"/api/ClientDownloads/Desktop/WindowsDesktop-x86/{_organizationId}{_tokenQuery}")">
                        <i class="oi oi-data-transfer-download" aria-hidden="true"></i>
                        <span>Windows EXE</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="sr-card flex flex-col">
            <div class="sr-card-header">Linux 64-Bit</div>
            <div class="sr-card-body flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <a target="_blank" class="sr-btn sr-btn-primary w-full justify-start text-base" href="@($"/api/ClientDownloads/Desktop/UbuntuDesktop/{_organizationId}{_tokenQuery}")">
                        <i class="oi oi-data-transfer-download" aria-hidden="true"></i>
                        <span>Ubuntu Executable</span>
                    </a>
                </div>
            </div>
        </div>
        <div class="sr-card flex flex-col">
            <div class="sr-card-header">Android (8.0+)</div>
            <div class="sr-card-body flex flex-col gap-4">
                <div class="flex flex-col gap-2">
                    <a target="_blank" class="sr-btn sr-btn-primary w-full justify-start text-base" href="/api/ClientDownloads/Desktop/AndroidApk">
                        <i class="oi oi-data-transfer-download" aria-hidden="true"></i>
                        <span>Android APK</span>
                    </a>
                </div>
                <p class="sr-help mt-0">
                    Sideloading required. Enable <em>Install unknown apps</em> in Android Settings → Apps before installing.
                </p>
                @if (!string.IsNullOrWhiteSpace(_androidSetupQr))
                {
                    @* Scan with the phone: opens a setup page with the download and a link that
                       fills in this server and organization in the app. *@
                    <div class="flex items-center gap-4 rounded-lg border border-border bg-surface-sunken p-3">
                        <img class="size-32 shrink-0 rounded bg-white p-1" width="128" height="128" src="@_androidSetupQr" alt="QR code to set up the Android agent" />
                        <div class="text-sm">
                            <div class="font-medium">Scan to install</div>
                            <p class="mb-2 mt-1 text-muted">Opens the setup page on the phone: install the app, then connect it to this server in one tap.</p>
                            <a class="break-all text-xs" href="@_androidSetupUrl" target="_blank">Open setup page</a>
                        </div>
                    </div>
                }
            </div>
        </div>
        @*<div class="sr-card">
        <strong>macOS x64 (10.12 - 10.15)</strong>
        <p>
        <a target="_blank" href="@($"/api/ClientDownloads/Desktop/MacOS-x64/{_organizationId}{_tokenQuery}")">macOS x64 Executable</a>
        </p>
