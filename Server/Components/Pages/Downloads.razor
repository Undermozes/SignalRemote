@code {
    private string? _organizationId;
    private bool _isAuthenticated;
    private string? _androidSetupUrl;
    private string? _androidSetupQr;
    private string _tokenQuery = string.Empty;
    private DateTimeOffset _linksExpireAt;

    protected override async Task OnInitializedAsync()
    {
        _isAuthenticated = await Auth.IsAuthenticated();

        if (_isAuthenticated)
        {
            var userResult = await Auth.GetUser();
            if (userResult.IsSuccess)
            {
                _organizationId = userResult.Value.OrganizationID;
            }
        }

        if (!string.IsNullOrWhiteSpace(_organizationId))
        {
            // Downloads are never public: links on this page work for 24 hours, so they
            // can be copied and sent to a customer.
            var lifetime = TimeSpan.FromHours(24);
            _linksExpireAt = DateTimeOffset.UtcNow + lifetime;
            _tokenQuery = $"?{DownloadLinkService.QueryKey}={Uri.EscapeDataString(DownloadLinks.CreateToken(_organizationId, lifetime))}";
            _androidSetupUrl = $"{NavManager.BaseUri}api/ClientDownloads/AndroidSetup/{Uri.EscapeDataString(_organizationId)}{_tokenQuery}";
            var png = QRCoder.PngByteQRCodeHelper.GetQRCode(_androidSetupUrl, QRCoder.QRCodeGenerator.ECCLevel.M, 8);
            _androidSetupQr = $"data:image/png;base64,{Convert.ToBase64String(png)}";
        }

        await base.OnInitializedAsync();
    }
}