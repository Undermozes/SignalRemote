@inject IThemeProvider ThemeProvider

<div class="fixed inset-0 z-[1000] flex items-center justify-center bg-black/50 p-4">
    <div class="text-center">
        @if (!string.IsNullOrEmpty(StatusMessage))
        {
            <h4 class="mb-2 text-xl font-medium">
                @StatusMessage
            </h4>
        }
        <div class="signal mt-2.5 inline-block size-[50px] rounded-full border-8 border-solid @(GetSignalClass())"></div>
    </div>
</div>

@code {
    private Theme _theme;

    [Parameter]
    public string StatusMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        _theme = await ThemeProvider.GetEffectiveTheme();
        await base.OnInitializedAsync();
    }

    private string GetSignalClass()
    {
        return _theme == Theme.Dark ? "border-[whitesmoke]" : "border-[#333]";
    }
}