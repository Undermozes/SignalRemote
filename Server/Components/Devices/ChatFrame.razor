@attribute [Authorize]
@inherits AuthComponentBase

@if (_chatSessions.Any())
{
    @* Phones: a full-width bottom sheet above the Terminal tabs.  From md up: a side panel on the right. *@
    <div class="chat-frame fixed inset-x-0 bottom-[calc(3.75rem+env(safe-area-inset-bottom))] z-30 flex max-h-[calc(100dvh-7.5rem)] flex-col gap-2 overflow-y-auto px-2
                md:left-auto md:right-4 md:bottom-14 md:w-96 md:px-0">
        @foreach (var session in _chatSessions)
        {
            <ChatCard @key="session.SessionId" Session="session" />
        }
    </div>
}
