@inherits AuthComponentBase

@{
    var isOpen = !string.IsNullOrWhiteSpace(_terminalOpenClass);
}

@* Closed: two tabs fixed to the bottom of the screen.
   Open: full screen on phones, a panel along the bottom (right of the sidebar) from md up. *@
<div class="terminal-frame @_terminalOpenClass fixed inset-x-0 bottom-0 flex flex-col pb-[env(safe-area-inset-bottom)] md:left-64 md:right-4 md:top-auto md:bg-transparent md:pb-0 md:pointer-events-none @(isOpen ? "top-0 z-40 bg-surface pt-[env(safe-area-inset-top)] md:pt-0" : "z-20 pointer-events-none")">
    <div class="flex items-end justify-between gap-2 px-2 pt-2 md:px-4 md:pt-0">
        <button class="sr-btn sr-btn-secondary pointer-events-auto shadow-md md:rounded-b-none md:border-b-0"
                aria-expanded="@(isOpen ? "true" : "false")"
                @onclick="ToggleTerminalOpen">
            <i class="oi @(isOpen ? "oi-x" : "oi-terminal")" aria-hidden="true"></i>
            <span>Terminal</span>
        </button>
        <button class="sr-btn sr-btn-secondary pointer-events-auto shadow-md md:rounded-b-none md:border-b-0" @onclick="ShowQuickScripts">
            <i class="oi oi-script" aria-hidden="true"></i>
            <span>Quick Scripts</span>
        </button>
    </div>

    <div class="@(isOpen ? "flex" : "hidden") pointer-events-auto mt-2 min-h-0 flex-1 flex-col overflow-hidden border-t border-border bg-gray-950 text-gray-100 shadow-xl
                md:mt-0 md:h-[25rem] md:max-h-[80dvh] md:flex-none md:rounded-t-lg md:border-x">
        <div @ref="_terminalWindow" class="min-h-0 flex-1 overflow-y-auto px-3 py-2 font-mono text-sm break-words whitespace-pre-wrap md:overflow-x-auto md:whitespace-pre">
            @foreach (var line in TerminalStore.TerminalLines)
            {
                <div @key="line.Id" class="min-h-[1.3em] @line.ClassName" title="@line.Title">
                    @line.Text
                </div>
            }
        </div>

        @* Which devices a command runs on, and which haven't answered yet. *@
        <div class="flex flex-wrap items-center gap-1.5 border-t border-border bg-surface-raised px-2 pt-2 text-xs text-fg">
            @if (_targets.Count == 0)
            {
                <span class="sr-badge sr-badge-warning">
                    <i class="oi oi-warning" aria-hidden="true"></i>
                    No device selected: tick the checkbox on a device card first
                </span>
            }
            else
            {
                <span class="font-medium text-muted">Runs on @Plural(_targets.Count, "device"):</span>
                @foreach (var device in _targets)
                {
                    <span @key="device.ID" class="sr-badge sr-badge-neutral max-w-[12rem]" title="@(device.IsOnline ? "Online" : "Offline: the command waits until it connects")">
                        <span class="size-2 shrink-0 rounded-full @(device.IsOnline ? "bg-success" : "bg-gray-400")"></span>
                        <span class="truncate">@(string.IsNullOrWhiteSpace(device.Alias) ? device.DeviceName : device.Alias)</span>
                    </span>
                }
            }
            @if (_pending.Count > 0)
            {
                <span class="inline-flex items-center gap-1.5 text-sky-500 sm:ml-auto" role="status">
                    <span class="size-3 animate-spin rounded-full border-2 border-sky-500 border-t-transparent"></span>
                    Waiting for @string.Join(", ", _pending.Values)
                </span>
            }
        </div>

        @* Phones: help + shell on one row, the command input full width below.  One row from md up. *@
        <div class="grid grid-cols-[auto_1fr] gap-2 bg-surface-raised p-2 md:grid-cols-[auto_auto_1fr]">
            <button class="sr-btn sr-btn-secondary w-11 px-0"
                    title="Terminal Help"
                    aria-label="Terminal Help"
                    @onclick="ShowTerminalHelp">
                <i class="oi oi-question-mark" aria-hidden="true"></i>
            </button>
            <select @bind="_shell" class="sr-select md:w-auto" aria-label="Shell">
                @foreach (var shell in Enum.GetValues(typeof(ScriptingShell)))
                {
                    <option @key="shell" value="@shell">@shell</option>
                }
            </select>
            <input @ref="_terminalInput"
                   class="sr-input col-span-2 font-mono md:col-span-1"
                   placeholder="Enter a terminal command"
                   aria-label="Terminal command"
                   spellcheck="false"
                   autocomplete="off"
                   autocapitalize="off"
                   @bind="InputText"
                   @bind:event="oninput"
                   @onkeypress="EvaluateInputKeypress"
                   @onkeydown="EvaluateKeyDown" />
        </div>
    </div>
</div>
