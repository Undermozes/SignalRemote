@attribute [Authorize]
@inherits AuthComponentBase

<div @ref="_card" class="device-card @_theme @GetCardStateClass() @CardClass"
     @onclick="ExpandCard"
     @onclick:stopPropagation
     @oncontextmenu="ContextMenuOpening"
     @oncontextmenu:preventDefault="_state == DeviceCardState.Normal"
     @oncontextmenu:stopPropagation="_state == DeviceCardState.Normal">

    @* Header: name, alias, status and selection.  Tapping it collapses an expanded card. *@
    <div class="@HeaderClass" @onclick="HandleHeaderClick"
         @onclick:stopPropagation="_state == DeviceCardState.Expanded"
         @onclick:preventDefault="_state == DeviceCardState.Expanded">
        <div class="min-w-0 flex-1">
            <div class="truncate font-semibold text-fg">@Device.DeviceName</div>
            <div class="min-h-5 truncate text-sm text-muted">@Device.Alias</div>
        </div>

        @if (Device.IsOnline)
        {
            if (IsOutdated)
            {
                <span class="sr-badge sr-badge-warning shrink-0" title="Agent Outdated">
                    <i class="oi oi-power-standby" aria-hidden="true"></i>
                    Outdated
                </span>
            }
            else
            {
                <span class="sr-badge sr-badge-success shrink-0" title="Online">
                    <i class="oi oi-power-standby" aria-hidden="true"></i>
                    Online
                </span>
            }
        }
        else
        {
            <span class="sr-badge sr-badge-danger shrink-0" title="Offline">
                <i class="oi oi-power-standby" aria-hidden="true"></i>
                Offline
            </span>
        }

        @if (IsExpanded)
        {
            <button class="sr-btn sr-btn-ghost w-11 shrink-0 px-0"
                    title="Open in New Tab"
                    aria-label="Open in New Tab"
                    @onclick:stopPropagation
                    @onclick="OpenDeviceDetails">
                <i class="oi oi-external-link" aria-hidden="true"></i>
            </button>
        }

        @* The label gives the checkbox a 44px touch target; clicks on it never expand the card. *@
        <label class="-my-2 -mr-2 flex size-11 shrink-0 cursor-pointer items-center justify-center"
               title="Select device"
               @onclick:stopPropagation>
            <input type="checkbox"
                   class="sr-checkbox"
                   aria-label="Select @Device.DeviceName"
                   checked="@IsSelected"
                   @onchange="ToggleIsSelected"
                   @onclick:stopPropagation />
        </label>
    </div>

    <div class="px-3 pb-3">
        @if (_fileUploadProgressLookup.Any())
        {
            foreach (var kvp in _fileUploadProgressLookup)
            {
                <div class="sr-alert sr-alert-info mb-2">
                    @(GetProgressMessage(kvp.Key))
                </div>
            }
        }

        @* At a glance: OS, signed-in user and CPU / memory / disk usage. *@
        <div class="flex min-w-0 flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
            <span class="inline-flex min-w-0 max-w-full items-center gap-1.5" title="Platform">
                <i class="oi oi-monitor" aria-hidden="true"></i>
                <span class="sr-only">Platform</span>
                <span class="truncate">@Device.Platform</span>
            </span>
            @if (!string.IsNullOrWhiteSpace(Device.CurrentUser))
            {
                <span class="inline-flex min-w-0 max-w-full items-center gap-1.5" title="User">
                    <i class="oi oi-person" aria-hidden="true"></i>
                    <span class="sr-only">User</span>
                    <span class="truncate">@Device.CurrentUser</span>
                </span>
            }
        </div>

        <div class="mt-2 grid grid-cols-3 gap-2 text-center @(IsExpanded ? "max-w-xl" : null)">
            <div class="rounded-lg bg-surface-sunken px-2 py-1.5">
                <div class="text-xs text-muted">CPU</div>
                <div class="text-sm font-semibold tabular-nums text-fg">@MathHelper.GetFormattedPercent(Device.CpuUtilization)</div>
            </div>
            <div class="rounded-lg bg-surface-sunken px-2 py-1.5">
                <div class="text-xs text-muted">Memory</div>
                <div class="text-sm font-semibold tabular-nums text-fg">@(MathHelper.GetFormattedPercent(Device.UsedMemoryPercent))</div>
            </div>
            <div class="rounded-lg bg-surface-sunken px-2 py-1.5">
                <div class="text-xs text-muted">Disk</div>
                <div class="text-sm font-semibold tabular-nums text-fg">@(MathHelper.GetFormattedPercent(Device.UsedStoragePercent))</div>
            </div>
        </div>
    </div>

    @* Actions.  Hidden (not removed) while collapsed, so a running file upload keeps its input element. *@
    @* On wide screens the expanded card spans the whole row; keep its content readable. *@
    <div class="@(IsExpanded ? null : "hidden") border-t border-border px-3 py-3 *:max-w-7xl">
        <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">Actions</div>
        <div class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap">
            @* The inline onclick on the wrapper runs during the tap itself, so mobile Safari lets it
               open the viewer window; see preopenPendingWindow in interop.js. *@
            <span class="contents" onclick="preopenPendingWindow()">
                <button class="sr-btn sr-btn-primary col-span-2" @onclick="() => StartRemoteControl(false)">
                    <i class="oi oi-laptop" aria-hidden="true"></i>
                    Remote Control
                </button>
                <button class="sr-btn sr-btn-secondary" @onclick="() => StartRemoteControl(true)">
                    <i class="oi oi-eye" aria-hidden="true"></i>
                    View Only
                </button>
            </span>
            <button class="sr-btn sr-btn-secondary" @onclick="StartChat">
                <i class="oi oi-chat" aria-hidden="true"></i>
                Chat
            </button>
            @if (_isClaudeAssistantEnabled)
            {
                <button class="sr-btn sr-btn-secondary" @onclick="OpenClaudeAssistant">
                    <i class="oi oi-lightbulb" aria-hidden="true"></i>
                    Claude Assistant
                </button>
            }
            <button class="sr-btn sr-btn-secondary" @onclick="() => WakeDevice()">
                <i class="oi oi-power-standby" aria-hidden="true"></i>
                Wake
            </button>
            <FileInputButton ClassNames="sr-btn sr-btn-secondary"
                             OnChanged="OnFileInputChanged">
                <ButtonContent>
                    <i class="oi oi-data-transfer-upload" aria-hidden="true"></i>
                    Upload File
                </ButtonContent>
            </FileInputButton>
            <button class="sr-btn sr-btn-secondary" @onclick="UpdateAgent" disabled="@(!Device.IsOnline)">
                <i class="oi oi-cloud-download" aria-hidden="true"></i>
                Update Agent
            </button>
        </div>

        @* Destructive actions sit apart from the everyday ones. *@
        <div class="mt-4 rounded-lg border border-red-500/30 bg-red-500/5 p-3 sm:w-fit">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-danger">Danger zone</div>
            <div class="flex flex-col gap-2 sm:flex-row sm:flex-wrap">
                @if (User?.IsAdministrator == true)
                {
                    <button class="sr-btn sr-btn-secondary" @onclick="ResetDeviceSecret">
                        <i class="oi oi-key" aria-hidden="true"></i>
                        Reset Device Secret
                    </button>
                }
                <button class="sr-btn sr-btn-danger" @onclick="UninstallAgent">
                    <i class="oi oi-delete" aria-hidden="true"></i>
                    Uninstall
                </button>
            </div>
        </div>
    </div>

    @if (IsExpanded)
    {
        <div class="border-t border-border px-3 py-3 *:max-w-7xl">
            <div class="mb-2 text-xs font-semibold uppercase tracking-wide text-muted">Details</div>

            <div class="grid grid-cols-2 gap-2 text-sm sm:max-w-xl">
                <div class="rounded-lg bg-surface-sunken px-3 py-2">
                    <div class="text-xs text-muted">Total Storage</div>
                    <div class="font-medium text-fg">@(Device.TotalStorage) GB</div>
                    <button class="sr-btn sr-btn-link min-h-11 text-sm"
                            @onclick="ShowAllDisks"
                            @onclick:stopPropagation>
                        View all disks
                    </button>
                </div>
                <div class="rounded-lg bg-surface-sunken px-3 py-2">
                    <div class="text-xs text-muted">Total Memory</div>
                    <div class="font-medium text-fg">@(Device.TotalMemory) GB</div>
                </div>
            </div>

            <div class="mt-3 grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
                <label class="mb-0 block min-w-0">
                    <span class="sr-label">Device ID</span>
                    <input class="sr-input cursor-default bg-surface-sunken" readonly value="@Device.ID" />
                </label>
                <label class="mb-0 block min-w-0">
                    <span class="sr-label">Agent Version</span>
                    <input class="sr-input cursor-default bg-surface-sunken" readonly value="@Device.AgentVersion" />
                </label>
                <label class="mb-0 block min-w-0">
                    <span class="sr-label">Last Online</span>
                    <input class="sr-input cursor-default bg-surface-sunken" readonly value="@Device.LastOnline" />
                </label>
                <label class="mb-0 block min-w-0">
                    <span class="sr-label">Public IP</span>
                    <input class="sr-input cursor-default bg-surface-sunken" readonly value="@Device.PublicIP" />
                </label>
                <label class="mb-0 block min-w-0 md:col-span-2 xl:col-span-4">
                    <span class="sr-label">MAC Addresses</span>
                    <input class="sr-input cursor-default bg-surface-sunken"
                           readonly
                           value="@(string.Join(", ", Device.MacAddresses ?? Array.Empty<string>()))" />
                </label>
            </div>

            <EditForm Model="Device" OnValidSubmit="HandleValidSubmit" class="mt-4 border-t border-border pt-3">
                <DataAnnotationsValidator />

                <div class="grid grid-cols-1 gap-3 md:grid-cols-2 xl:grid-cols-4">
                    <label class="mb-0 block min-w-0">
                        <span class="sr-label">Device Alias</span>
                        <InputText class="sr-input" @bind-Value="@Device.Alias" />
                        <ValidationMessage For="() => Device.Alias" />
                    </label>

                    <label class="mb-0 block min-w-0">
                        <span class="sr-label">Device Group</span>
                        <InputSelect @bind-Value="Device.DeviceGroupID" class="sr-select">
                            <option value="">None</option>

                            @foreach (var group in _deviceGroups)
                            {
                                <option @key="group.ID" value="@group.ID">@group.Name</option>
                            }
                        </InputSelect>
                        <ValidationMessage For="() => Device.DeviceGroupID" />
                    </label>

                    <label class="mb-0 block min-w-0 md:col-span-2">
                        <span class="sr-label">Tags</span>
                        <InputText @bind-Value="Device.Tags" class="sr-input" />
                        <ValidationMessage For="() => Device.Tags" />
                    </label>

                    <label class="mb-0 block min-w-0 md:col-span-2 xl:col-span-4">
                        <span class="sr-label">Notes</span>
                        <InputTextArea @bind-Value="Device.Notes" class="sr-textarea h-40"></InputTextArea>
                        <ValidationMessage For="() => Device.Notes" />
                    </label>
                </div>

                <div class="mt-2">
                    <ValidationSummary />
                </div>

                <div class="mt-3 flex justify-end">
                    <button type="submit" class="sr-btn sr-btn-primary w-full sm:w-auto">Save</button>
                </div>
            </EditForm>
        </div>
    }
</div>
