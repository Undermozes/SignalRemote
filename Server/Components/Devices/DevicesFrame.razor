@attribute [Authorize]
@inherits AuthComponentBase

@* Right padding leaves room for the alerts button (AlertsFrame) in the top-right corner. *@
<h3 class="sr-page-title pr-16">Devices</h3>

<div @onclick="ClearSelectedCard">
    @* Mobile first: every control stacks full width on phones; a grid from sm up. *@
    <div id="deviceControlsWrapper" class="sr-card mb-4 grid grid-cols-1 gap-3 p-3 sm:grid-cols-2 sm:p-4 lg:grid-cols-4">
        <div class="sm:col-span-2">
            <label class="sr-label" for="deviceSearchInput">Search</label>
            <div class="flex gap-2">
                <input id="deviceSearchInput"
                       class="sr-input min-w-0 flex-1"
                       type="search"
                       placeholder="Search device properties"
                       @bind="_filter" />
                @* On phones, group and sort are folded away so the device list starts on screen. *@
                <button class="sr-btn sr-btn-secondary shrink-0 sm:hidden"
                        aria-expanded="@(_showFilters ? "true" : "false")"
                        aria-controls="deviceGroupFilter deviceSortFilter"
                        @onclick="() => _showFilters = !_showFilters"
                        @onclick:stopPropagation="true">
                    <span class="oi oi-list" aria-hidden="true"></span>
                    Filters
                </button>
            </div>
        </div>

        <div id="deviceGroupFilter" class="@(_showFilters ? "block" : "hidden") sm:block">
            <label class="sr-label" for="deviceGroupSelect">Device Group</label>
            <div class="flex gap-2">
                <select id="deviceGroupSelect" class="sr-select min-w-0 flex-1" @bind="_selectedGroupId">
                    <option value="@_deviceGroupAll">All</option>
                    <option value="@_deviceGroupNone">None</option>
                    @foreach (var group in _deviceGroups)
                    {
                        <option @key="group.ID" value="@group.ID">@group.Name</option>
                    }
                </select>
                <button class="sr-btn sr-btn-secondary w-11 shrink-0 px-0"
                        title="Wake Devices in Group"
                        aria-label="Wake Devices in Group"
                        @onclick="WakeDevices">
                    <span class="oi oi-power-standby" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <div id="deviceSortFilter" class="@(_showFilters ? "block" : "hidden") sm:block">
            <label class="sr-label" for="deviceSortSelect">Sort</label>
            <div class="flex gap-2">
                <select id="deviceSortSelect" class="sr-select min-w-0 flex-1" @bind="_selectedSortProperty">
                    <option value=""></option>
                    @foreach (var prop in _sortableProperties)
                    {
                        <option value="@prop.Name">@GetDisplayName(prop)</option>
                    }
                </select>
                <button class="sr-btn sr-btn-secondary w-11 shrink-0 px-0"
                        title="Sort Direction"
                        aria-label="Sort Direction"
                        @onclick="ToggleSortDirection">
                    <span class="oi @GetSortIcon()" aria-hidden="true"></span>
                </button>
            </div>
        </div>

        <div class="flex flex-col gap-3 border-t border-border pt-3 sm:col-span-2 lg:col-span-4 lg:flex-row lg:items-center lg:justify-between">
            <div class="flex flex-wrap items-center gap-2">
                <label class="mb-0 inline-flex min-h-11 w-full cursor-pointer items-center gap-2 text-sm text-fg sm:mr-2 sm:w-auto"
                       for="hideOfflineDevicesCheckbox">
                    <input id="hideOfflineDevicesCheckbox" type="checkbox" class="sr-checkbox" @bind="_hideOfflineDevices" />
                    Hide offline devices
                </label>
                <button class="sr-btn sr-btn-secondary flex-1 sm:flex-none" @onclick="SelectAllCards">Select All</button>
                <button class="sr-btn sr-btn-primary flex-1 sm:flex-none" @onclick="HandleRefreshClicked">
                    <span class="oi oi-reload" aria-hidden="true"></span>
                    Refresh
                </button>
            </div>

            <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-fg">
                <div class="flex items-center gap-2">
                    <button class="sr-btn sr-btn-secondary w-11 shrink-0 px-0" title="Previous page" aria-label="Previous page" @onclick="PageDown">
                        <i class="oi oi-chevron-left" aria-hidden="true"></i>
                    </button>
                    <span class="text-muted">Page</span>
                    <input id="currentPageInput"
                           class="sr-input w-16 text-center"
                           inputmode="numeric"
                           aria-label="Current page"
                           pattern="[0-9]"
                           @bind="_currentPage"
                           @bind:event="oninput" />
                    <span class="text-muted">of</span>
                    <span class="font-medium tabular-nums">@TotalPages</span>
                    <button class="sr-btn sr-btn-secondary w-11 shrink-0 px-0" title="Next page" aria-label="Next page" @onclick="PageUp">
                        <i class="oi oi-chevron-right" aria-hidden="true"></i>
                    </button>
                </div>

                <div class="flex items-center gap-2">
                    <select class="sr-select w-24" aria-label="Devices per page" @bind="_devicesPerPage">
                        <option value="25">25</option>
                        <option value="50">50</option>
                        <option value="100">100</option>
                        <option value="200">200</option>
                    </select>
                    <span class="text-muted">per page</span>
                </div>
            </div>
        </div>
    </div>

    @* One column of compact cards on phones, a grid from md up.  Bottom padding keeps the
       last cards clear of the fixed Terminal / Quick Scripts tabs.
       An expanded card spans the full row.  Dense packing lets the next cards fill the
       rest of its row instead of leaving a gap, so the details open below that row. *@
    <div id="deviceListDiv" class="grid grid-cols-1 items-start gap-3 pb-24 md:grid-cols-2 xl:grid-cols-3 2xl:grid-cols-4" style="grid-auto-flow: row dense">
        @foreach (var device in DisplayedDevices)
        {
            <CascadingValue Value="this">
                <DeviceCard @key="device.ID" Device="device" />
            </CascadingValue>
        }
    </div>

    <Terminal />
</div>
