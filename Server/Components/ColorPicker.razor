@using Remotely.Server.Models
 
<div>
    <div class="sr-label">Color Sample:</div>
    <div class="mb-2 size-[50px] rounded-full border border-border" style="background-color:@($"rgb({Red},{Green},{Blue})")"></div>

    <div class="sr-label">Red</div>
    <input type="range" min="0" max="255" class="red-picker block h-11 w-full cursor-pointer accent-brand" @bind="Red" />
    <input type="number" min="0" max="255" class="sr-input mb-4 sm:w-[150px]" @bind="Red" />

    <div class="sr-label">Green</div>
    <input type="range" min="0" max="255" class="green-picker block h-11 w-full cursor-pointer accent-brand" @bind="Green" />
    <input type="number" min="0" max="255" class="sr-input mb-4 sm:w-[150px]" @bind="Green" />

    <div class="sr-label">Blue</div>
    <input type="range" min="0" max="255" class="blue-picker block h-11 w-full cursor-pointer accent-brand" @bind="Blue" />
    <input type="number" min="0" max="255" class="sr-input mb-4 sm:w-[150px]" @bind="Blue" />
</div>


@code {

    private ColorPickerModel _color = new();

    [Parameter]
    public ColorPickerModel Color
    {
        get
        {
            return _color;
        }
        set
        {
            _color = value;

        }
    }

    [Parameter]
    public EventCallback<ColorPickerModel> ColorChanged { get; set; }

    public byte Blue
    {
        get => Color.Blue;
        set
        {
            Color.Blue = value;
            ColorChanged.InvokeAsync(_color);
        }
    }
    public byte Green
    {
        get => Color.Green;
        set
        {
            Color.Green = value;
            ColorChanged.InvokeAsync(_color);
        }
    }
    public byte Red
    {
        get => Color.Red;
        set
        {
            Color.Red = value;
            ColorChanged.InvokeAsync(_color);
        }
    }
}
