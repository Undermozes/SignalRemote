﻿@using Remotely.Server.Components
@using Remotely.Server.Auth
@inherits LayoutComponentBase
@inject NavigationManager NavMan

<AuthorizeView Policy="@PolicyNames.TwoFactorRequired">
    <Authorized>
        @* Mobile first: a top bar with a menu on phones, a fixed sidebar from md (768px) up. *@
        <div class="min-h-dvh bg-surface md:flex">
            <aside class="contents">
                <NavMenu />
            </aside>

            <main class="min-w-0 flex-1 px-4 pb-[max(1rem,env(safe-area-inset-bottom))] pt-4 md:px-8 md:pt-6">
                @Body
            </main>
        </div>
    </Authorized>
    <NotAuthorized>
        <div class="flex min-h-dvh items-center justify-center bg-surface-sunken px-4 py-10">
            <div class="w-full max-w-md rounded-2xl border border-border bg-surface-raised p-6 shadow-xl shadow-black/5 sm:p-8">
                <div class="mb-5 flex size-12 items-center justify-center rounded-full bg-brand/10 text-brand dark:bg-brand/20 dark:text-blue-300">
                    <Icon Name="shield-check" Class="size-6" />
                </div>
                <h1 class="mb-1 text-xl font-semibold">Set up two-factor authentication</h1>
                <p class="mb-5 text-sm text-muted">
                    This portal requires a second step when you sign in. It takes about a minute:
                </p>
                <ol class="mb-6 list-none space-y-3 p-0 text-sm">
                    <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-surface-sunken text-xs font-semibold">1</span> Install an authenticator app, such as Microsoft or Google Authenticator.</li>
                    <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-surface-sunken text-xs font-semibold">2</span> Scan the QR code on the next page.</li>
                    <li class="flex gap-3"><span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-surface-sunken text-xs font-semibold">3</span> Enter the 6-digit code to confirm.</li>
                </ol>
                <button class="sr-btn sr-btn-primary min-h-12 w-full text-base" @onclick="NavigateToTwoFactor">
                    Get started <Icon Name="arrow-right" Class="size-4" />
                </button>
            </div>
        </div>
    </NotAuthorized>
</AuthorizeView>

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

<ToastHarness />
<LoaderHarness />
<ModalHarness />

@code {
    private void NavigateToTwoFactor()
    {
        NavMan.NavigateTo("/Account/Manage/TwoFactorAuthentication", true);
    }
}
