@implements IDisposable
@inject NavigationManager NavigationManager
@inject IAuthService AuthService 
@inject IDataService DataService

@* CSS-only toggle (checkbox + peer-checked), so the menu also opens on the statically
   rendered /Account pages.  On interactive pages, tapping a link unchecks it. *@
<input type="checkbox" id="navMenuToggle" class="peer sr-only" aria-label="Menu" @bind="_menuOpen" />

<div class="flex h-14 items-center justify-between bg-black/30 pl-4 pr-2">
    <a class="min-w-0 text-white no-underline" href="">
        <div class="truncate text-lg font-semibold leading-tight">
            @if (!string.IsNullOrWhiteSpace(_organization?.OrganizationName))
            {
                @_organization.OrganizationName
            }
            else
            {
                <span>Remotely</span>
            }
        </div>
        <div class="text-xs text-sky-400">Support Portal</div>
    </a>
    <label for="navMenuToggle"
           class="flex size-12 cursor-pointer items-center justify-center rounded-lg text-2xl text-gray-200 hover:bg-white/10 md:hidden"
           title="Menu">
        <span class="oi oi-menu" aria-hidden="true"></span>
    </label>
</div>

@* On phones the menu opens below the top bar and closes after a tap.  From md up it's always shown. *@
<nav class="hidden peer-checked:block max-h-[calc(100dvh-3.5rem)] overflow-y-auto px-3 py-3 md:block md:max-h-none" @onclick="CloseNavMenu">
    <ul class="m-0 flex list-none flex-col gap-1 p-0">
        <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="" Match="NavLinkMatch.All">
                <span class="oi oi-home w-5 text-center" aria-hidden="true"></span> Home
            </NavLink>
        </li>
        <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="downloads">
                <span class="oi oi-cloud-download w-5 text-center" aria-hidden="true"></span> Downloads
            </NavLink>
        </li>
        <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="/Viewer" target="_blank">
                <span class="oi oi-monitor w-5 text-center" aria-hidden="true"></span> Remote Control
            </NavLink>
        </li>

        <AuthorizeView>
            <Authorized>
                <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="deploy">
                <span class="oi oi-data-transfer-upload w-5 text-center" aria-hidden="true"></span> Deploy
            </NavLink>
        </li>
                <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="scripts">
                <span class="oi oi-script w-5 text-center" aria-hidden="true"></span> Scripts
            </NavLink>
        </li>
                <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="device-details">
                <span class="oi oi-info w-5 text-center" aria-hidden="true"></span> Device Details
            </NavLink>
        </li>
                <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="user-options">
                <span class="oi oi-pencil w-5 text-center" aria-hidden="true"></span> User Options
            </NavLink>
        </li>
                <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="backup">
                <span class="oi oi-hard-drive w-5 text-center" aria-hidden="true"></span> Backup
            </NavLink>
        </li>
            </Authorized>
        </AuthorizeView>

        @if (_user?.IsAdministrator == true)
        {
            <li class="px-3 pb-1 pt-4 text-xs font-semibold uppercase tracking-wide text-gray-400">
                Admin
            </li>
            <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="manage-organization">
                <span class="oi oi-briefcase w-5 text-center" aria-hidden="true"></span> Organization
            </NavLink>
        </li>
            <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="branding">
                <span class="oi oi-brush w-5 text-center" aria-hidden="true"></span> Branding
            </NavLink>
        </li>
            <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="api-keys">
                <span class="oi oi-key w-5 text-center" aria-hidden="true"></span> API Keys
            </NavLink>
        </li>

            @if (_user?.IsServerAdmin == true)
            {
                <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="server-logs">
                <span class="oi oi-document w-5 text-center" aria-hidden="true"></span> Server Logs
            </NavLink>
        </li>
                <li>
            <NavLink class="flex h-12 items-center gap-3 rounded-lg px-3 text-[0.95rem] text-gray-300 no-underline hover:bg-white/10 hover:text-white" ActiveClass="bg-white/20 text-white" href="server-config">
                <span class="oi oi-wrench w-5 text-center" aria-hidden="true"></span> Server Config
            </NavLink>
        </li>
            }
        }

        <li class="my-3 border-t border-white/10"></li>

        <AuthorizeView>
            <Authorized>
                <li>
                    <a class="flex h-11 w-full items-center rounded-lg px-3 text-left text-gray-300 no-underline hover:bg-white/10 hover:text-white" href="Account/Manage">Account</a>
                </li>
                <li>
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@_currentUrl" />
                        <button type="submit" class="flex h-11 w-full items-center rounded-lg px-3 text-left text-gray-300 no-underline hover:bg-white/10 hover:text-white border-0 bg-transparent">
                            Logout
                        </button>
                    </form>
                </li>
            </Authorized>
            <NotAuthorized>
                <li>
                    <a class="flex h-11 w-full items-center rounded-lg px-3 text-left text-gray-300 no-underline hover:bg-white/10 hover:text-white" href="Account/Login">Log in</a>
                </li>
                @if (_isRegistrationEnabled)
                {
                    <li>
                        <a class="flex h-11 w-full items-center rounded-lg px-3 text-left text-gray-300 no-underline hover:bg-white/10 hover:text-white" href="Account/Register">Register</a>
                    </li>
                }
            </NotAuthorized>
        </AuthorizeView>

        <li>
            <a class="flex h-11 w-full items-center rounded-lg px-3 text-left text-gray-300 no-underline hover:bg-white/10 hover:text-white" href="/about">About</a>
        </li>
    </ul>
</nav>

@code {
    private bool _menuOpen;
    private bool _isRegistrationEnabled;
    private RemotelyUser? _user;
    private Organization? _organization;
    private string? _currentUrl;

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        var settings = await DataService.GetSettings();
        _isRegistrationEnabled = settings.MaxOrganizationCount < 0 || DataService.GetOrganizationCount() < settings.MaxOrganizationCount;

        await base.OnInitializedAsync();

        _currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;

        var userResult = await AuthService.GetUser();

        if (!userResult.IsSuccess)
        {
            return;
        }

        _user = userResult.Value;

        if (!string.IsNullOrWhiteSpace(_user?.OrganizationID))
        {
            var orgResult = await DataService.GetOrganizationById(_user.OrganizationID);
            if (orgResult.IsSuccess)
            {
                _organization = orgResult.Value;
            }
        }
        else
        {
            var orgResult = await DataService.GetDefaultOrganization();
            if (orgResult.IsSuccess)
            {
                _organization = orgResult.Value;
            }
        }
    }

    private void CloseNavMenu()
    {
        _menuOpen = false;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        _currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        InvokeAsync(StateHasChanged);
    }
}
