@* One-line status entry in the Claude history timeline. *@
<div class="flex items-center gap-2 pl-1 text-sm @Class">
    <span class="oi @Icon" aria-hidden="true"></span>
    <span>@Text</span>
    <span class="text-xs text-muted">· <EventTime Value="Timestamp" /></span>
</div>

@code {
    [Parameter]
    public string Icon { get; set; } = "oi-info";

    [Parameter]
    public string? Class { get; set; }

    [Parameter]
    public string? Text { get; set; }

    [Parameter]
    public DateTimeOffset Timestamp { get; set; }
}
