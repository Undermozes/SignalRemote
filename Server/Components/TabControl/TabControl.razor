@* Phones: the tab bar scrolls sideways instead of wrapping. *@
<ul class="m-0 flex list-none gap-1 overflow-x-auto overscroll-x-contain border-b border-border p-0 [scrollbar-width:thin]" role="tablist">
    <CascadingValue Value="this">
        @TabHeaders
    </CascadingValue>
</ul>
<div class="pt-1">
    <CascadingValue Value="this">
        @TabContents
    </CascadingValue>
</div>


@code {
    [Parameter]
    public RenderFragment? TabHeaders { get; set; }

    [Parameter]
    public RenderFragment? TabContents { get; set; }

    [Parameter]
    public string? InitialActiveTab { get; set; }

    public string? ActiveTab { get; set; }

    protected override void OnInitialized()
    {
        ActiveTab = InitialActiveTab;
    }

    public void SetActiveTab(TabHeader header)
    {
        ActiveTab = header.Name;
        StateHasChanged();
    }
}
