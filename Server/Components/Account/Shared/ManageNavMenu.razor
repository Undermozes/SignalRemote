@using Microsoft.AspNetCore.Identity
@using Remotely.Server.Data

@inject SignInManager<RemotelyUser> SignInManager

<nav aria-label="Account settings" class="-mx-4 overflow-x-auto border-b border-border px-4 pb-2 md:mx-0 md:overflow-visible md:border-b-0 md:px-0 md:pb-0">
    <ul class="m-0 flex list-none gap-1 p-0 md:flex-col">
        <li class="shrink-0">
            <NavLink class="flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 text-sm font-medium text-muted no-underline hover:bg-surface-sunken hover:text-fg" ActiveClass="bg-brand/10 [&]:text-brand dark:bg-brand/20 dark:[&]:text-blue-300" href="Account/Manage" Match="NavLinkMatch.All">Profile</NavLink>
        </li>
        <li class="shrink-0">
            <NavLink class="flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 text-sm font-medium text-muted no-underline hover:bg-surface-sunken hover:text-fg" ActiveClass="bg-brand/10 [&]:text-brand dark:bg-brand/20 dark:[&]:text-blue-300" href="Account/Manage/Email">Email</NavLink>
        </li>
        <li class="shrink-0">
            <NavLink class="flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 text-sm font-medium text-muted no-underline hover:bg-surface-sunken hover:text-fg" ActiveClass="bg-brand/10 [&]:text-brand dark:bg-brand/20 dark:[&]:text-blue-300" href="Account/Manage/ChangePassword">Password</NavLink>
        </li>
        @if (hasExternalLogins)
        {
            <li class="shrink-0">
                <NavLink class="flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 text-sm font-medium text-muted no-underline hover:bg-surface-sunken hover:text-fg" ActiveClass="bg-brand/10 [&]:text-brand dark:bg-brand/20 dark:[&]:text-blue-300" href="Account/Manage/ExternalLogins">External logins</NavLink>
            </li>
        }
        <li class="shrink-0">
            <NavLink class="flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 text-sm font-medium text-muted no-underline hover:bg-surface-sunken hover:text-fg" ActiveClass="bg-brand/10 [&]:text-brand dark:bg-brand/20 dark:[&]:text-blue-300" href="Account/Manage/TwoFactorAuthentication">Two-factor authentication</NavLink>
        </li>
        <li class="shrink-0">
            <NavLink class="flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 text-sm font-medium text-muted no-underline hover:bg-surface-sunken hover:text-fg" ActiveClass="bg-brand/10 [&]:text-brand dark:bg-brand/20 dark:[&]:text-blue-300" href="Account/Manage/PersonalData">Personal data</NavLink>
        </li>
    </ul>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
