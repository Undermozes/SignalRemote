<StatusMessage Message="@StatusMessage" />
<h3 class="sr-section-title mt-0">Recovery codes</h3>
<div class="sr-alert sr-alert-warning" role="alert">
    <span class="oi oi-warning mt-0.5 text-warning" aria-hidden="true"></span>
    <div class="space-y-2">
        <p class="m-0">
            <strong>Put these codes in a safe place.</strong>
        </p>
        <p class="m-0">
            If you lose your device and don't have the recovery codes you will lose access to your account.
        </p>
    </div>
</div>
<div class="grid max-w-lg grid-cols-2 gap-2 sm:grid-cols-3">
    @foreach (var recoveryCode in RecoveryCodes)
    {
        <div>
            <code class="recovery-code block rounded-lg bg-surface-sunken px-3 py-2 text-center font-mono text-sm text-fg">@recoveryCode</code>
        </div>
    }
</div>

@code {
    [Parameter]
    public string[] RecoveryCodes { get; set; } = [];

    [Parameter]
    public string? StatusMessage { get; set; }
}
